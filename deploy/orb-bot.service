[Unit]
Description=ORB Nifty 50 batch paper runner (paper only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
# Private broker/API credentials and sizing values are read from the repository .env file.
EnvironmentFile=-__DIR__/.env
# Explicit opt-in: the dedicated runner refuses to start without this exact mode.
Environment=ORB_RUNTIME_MODE=nifty50_batch
Environment=ANGEL_WS_CONNECT_TIMEOUT=90
Environment=PYTHONUNBUFFERED=1
Environment=ORB_LOCK_FILE=/tmp/orb-paper-bot.lock
UMask=0077
ExecStart=__DIR__/.venv/bin/python -u nifty50_runner.py
# No automatic restart until restart/position-restoration acceptance is complete.
Restart=no
TimeoutStopSec=45
