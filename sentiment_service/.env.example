# Model is loaded once when the service starts. Pin a tested commit hash before production.
SENTIMENT_MODEL_ID=StephanAkkerman/FinTwitBERT-sentiment
SENTIMENT_MODEL_REVISION=main
SENTIMENT_APP_VERSION=0.1.0
SENTIMENT_MAX_BATCH_SIZE=16
SENTIMENT_MAX_TEXT_LENGTH=4000
SENTIMENT_MAX_TOKEN_LENGTH=256
LOG_LEVEL=INFO

# Set APP_ENV=production and a strong random token for deployed services.
APP_ENV=development
SENTIMENT_API_TOKEN=
